sense.root=./manual-test/sense-root
target.dir=./manual-test/sense-root/Inbox
max.file.mb=10
sense.tree-depth=3
# 客户端使用后端时填写地址；填写后客户端不会读取 ai.api-key。
# ai.backend-url=http://127.0.0.1:8787
ai.base-url=https://www.fhl.mom
ai.api-key=
ai.model=gpt-6-luna
ai.reasoning-effort=medium
ai.wire-api=responses
ai.batch-size=10
ai.batch-concurrency=2
ai.max-requests=20
ai.max-prompt-chars=12000
tidy.delete-empty-directories=true
